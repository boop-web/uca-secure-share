generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  username   String    @unique
  email      String    @unique
  lastSeenAt DateTime? // set on sign-in and (at most every 10 min) on token refresh - for ucagg.de's numbers
  password   String?
  isAdmin    Boolean   @default(false)
  ldapDN     String?   @unique

  shares        Share[]
  refreshTokens RefreshToken[]
  loginTokens   LoginToken[]
  reverseShares ReverseShare[]

  totpEnabled        Boolean             @default(false)
  totpVerified       Boolean             @default(false)
  totpSecret         String?
  resetPasswordToken ResetPasswordToken?

  oAuthUsers OAuthUser[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthIDToken String? // prefixed with the ID of the issuing OAuth provider, separated by a colon
}

model LoginToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  used   Boolean @default(false)
}

model ResetPasswordToken {
  token     String   @id @default(uuid())
  createdAt DateTime @default(now())

  expiresAt DateTime

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthUser {
  id               String @id @default(uuid())
  provider         String
  providerUserId   String
  providerUsername String
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Share {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name          String?
  uploadLocked  Boolean  @default(false)
  isZipReady    Boolean  @default(false)
  views         Int      @default(0)
  expiration    DateTime
  description   String?
  removedReason String?

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  reverseShareId String?
  reverseShare   ReverseShare? @relation(fields: [reverseShareId], references: [id], onDelete: Cascade)

  security        ShareSecurity?
  recipients      ShareRecipient[]
  files           File[]
  storageProvider String           @default("LOCAL")

  // UCA Share v2 (6 Nov 2026): every link has one mode - "downloads" (ends after maxDownloads, at most 3 days) or
  // "days" (ends after 1-3 days). null = an older share or one an admin made without a mode.
  mode         String?
  maxDownloads Int?
  downloads    Int             @default(0)
  endedAt      DateTime? // the last allowed download started: no new visitor gets in; deleted by the cleanup shortly after
  pending      String? // app API: the files announced at create, JSON [{id, name, size}] until they are uploaded
  downloadLog  ShareDownload[]
}

// one row per real download (a file or the zip, counted once per visit); no IP, no location - only a device label
model ShareDownload {
  id      Int      @id @default(autoincrement())
  shareId String
  share   Share    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  ownerId String?
  n       Int
  at      DateTime @default(now())
  device  String
  visit   String

  @@index([shareId])
  @@index([ownerId, id])
}

model ReverseShare {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  token                 String   @unique @default(uuid())
  shareExpiration       DateTime
  maxShareSize          String
  sendEmailNotification Boolean
  remainingUses         Int
  simplified            Boolean  @default(false)
  publicAccess          Boolean  @default(true)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  shares Share[]
}

model ShareRecipient {
  id    String @id @default(uuid())
  email String

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model File {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  name String
  size String

  shareId String
  share   Share  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model ShareSecurity {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  password String?
  maxViews Int?

  shareId String? @unique
  share   Share?  @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

model Config {
  updatedAt DateTime @updatedAt

  name         String
  category     String
  type         String
  defaultValue String  @default("")
  value        String?
  obscured     Boolean @default(false)
  secret       Boolean @default(true)
  locked       Boolean @default(false)
  order        Int

  @@id([name, category])
}

model HomePage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String  @default("Welcome to UCA")
  description String  @default("Share files securely with style")
  bullet1Name String  @default("Secure Sharing")
  bullet1Desc String  @default("End-to-end encrypted file sharing")
  bullet2Name String  @default("Lightning Fast")
  bullet2Desc String  @default("Optimized performance for amazing developers")
  bullet3Name String  @default("Anonymous")
  bullet3Desc String  @default("Your privacy is our priority")
  buttonText  String  @default("Get Started")
  updatedBy   String?
}

// ---------- UCA control center (ucagg.de/admin, uca-control-v1) ----------

// every write that comes from ucagg.de (and sign-ins through its doors): who, what, when
model UcaAudit {
  id     Int      @id @default(autoincrement())
  at     DateTime @default(now())
  level  String   @default("info")
  kind   String
  actor  String?
  detail String?

  @@index([at])
}

// accounts reported to the UCA ID hub (POST https://ucagg.de/api/hub/v1/accounts); retried until done
model UcaHubQueue {
  id        Int       @id @default(autoincrement())
  email     String
  payload   String
  attempts  Int       @default(0)
  lastError String?
  nextTryAt DateTime?
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([email])
}

// small key/value facts: the last daily report, the one-time hub backfill
model UcaState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
