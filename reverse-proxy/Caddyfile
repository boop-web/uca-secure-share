:3000 {
	# The API (incl. file downloads) is never indexed
	header /api/* X-Robots-Tag "noindex, nofollow"

	# ucagg.de's sign-in doors (uca-admin-sso-v1, uca-id-sso-v1) go straight to the backend, query kept
	rewrite /admin/sso /api/uca/admin-sso
	rewrite /uca-id/sso /api/uca/id-sso

	# Reverse proxy for /api
	reverse_proxy /api/* http://localhost:{$BACKEND_PORT:8080}

	# Reverse proxy for all other requests
	reverse_proxy http://localhost:{$PORT:3333}
}
